DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: password reset delivery. Without RESEND_API_KEY the reset link is
# printed to the server console in development instead of being emailed.
RESEND_API_KEY=
MAIL_FROM=CampusFlow <no-reply@campusflow.edu>
# Public base URL used to build the reset link. Falls back to the request origin.
APP_URL=

# Google sign-in (optional). Both values are public: the anon key is protected by
# Supabase RLS, and the Google client secret lives only in the Supabase dashboard.
# Find them in Supabase -> Project Settings -> API. Leave blank to hide the button.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ojzysItMIH1VV9k-p47w-g_z2bbX3Vt
